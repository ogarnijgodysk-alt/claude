# Każdy klucz jest opcjonalny. Bez klucza dana funkcja działa w trybie DEMO
# (aplikacja jest w pełni klikalna, ale wyniki są przykładowe).

# Claude: skrypty, opisy, hashtagi, plan treści, odpowiedzi asystenta na stronie
ANTHROPIC_API_KEY=

# kie.ai (zalecane, najtańsze): sesje zdjęciowe bez treningu, twarze influencerów,
# mówiące wideo ze zdjęcia (Kling AI Avatar)
KIE_API_KEY=
# kling/ai-avatar-standard (720p, taniej) albo kling/ai-avatar-pro (1080p)
KIE_AVATAR_MODEL=kling/ai-avatar-standard

# HeyGen: cyfrowy bliźniak z nagrania wideo i render filmów z nim (API v3)
HEYGEN_API_KEY=
# Domyślny głos HeyGen dla klonów bez własnego głosu (ID z panelu HeyGen)
HEYGEN_DEFAULT_VOICE_ID=

# Tavus: rozmowa wideo na żywo z klonem na stronie firmy
TAVUS_API_KEY=
# Gotowa twarz Tavus (stock replica), używana, gdy nie nagrywasz własnej
TAVUS_DEFAULT_REPLICA_ID=

# ElevenLabs: klonowanie głosu z nagrania i synteza mowy
ELEVENLABS_API_KEY=

# fal.ai (opcjonalnie): własny model twarzy (LoRA) dla najwyższego podobieństwa
FAL_KEY=

# Publiczny adres aplikacji (np. https://studio.twojafirma.pl albo tunel ngrok).
# HeyGen, kie.ai i Tavus pobierają z niego nagrania. Bez niego pliki idą do
# tymczasowego magazynu kie.ai (lub fal.ai).
PUBLIC_BASE_URL=

# Katalog na bazę danych JSON i przesłane pliki
DATA_DIR=.data

# "browser" = wersja testowa: dane zostają w przeglądarce odwiedzającego,
# serwer obsługuje tylko zapytania AI. Do darmowego hostingu (np. Vercel).
NEXT_PUBLIC_STORAGE=
