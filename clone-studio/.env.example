# Każdy klucz jest opcjonalny. Bez klucza dana funkcja działa w trybie DEMO
# (aplikacja jest w pełni klikalna, ale wyniki są przykładowe).

# Claude: skrypty, opisy, hashtagi, plan treści
ANTHROPIC_API_KEY=

# HeyGen: cyfrowy bliźniak (klon z wideo), awatar ze zdjęcia, generowanie wideo
HEYGEN_API_KEY=
# Domyślny głos HeyGen dla klonów bez własnego głosu (ID z panelu HeyGen)
HEYGEN_DEFAULT_VOICE_ID=

# ElevenLabs: klonowanie głosu z nagrania i synteza mowy
ELEVENLABS_API_KEY=

# fal.ai: trening klona ze zdjęć (LoRA), sesje zdjęciowe, twarze AI influencerów
FAL_KEY=

# Publiczny adres aplikacji (np. https://studio.twojafirma.pl albo tunel ngrok).
# Potrzebny, gdy HeyGen ma pobrać nagrane audio. Bez niego pliki są wysyłane
# do magazynu fal.ai (jeśli jest FAL_KEY).
PUBLIC_BASE_URL=

# Katalog na bazę danych JSON i przesłane pliki
DATA_DIR=.data
