# Hosting współdzielony, gdy NIE da się ustawić katalogu głównego domeny na public/:
# całość trafia do public_html, a ten plik kieruje ruch do public/ i zamyka resztę.
# (Zalecane jednak ustawienie katalogu głównego domeny na .../public, wtedy ten plik jest zbędny.)
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(src|views|config|storage|bin|tests|docs|vendor)(/|$) - [F,L]
RewriteRule ^(schema\.sql|.*\.md)$ - [F,L]
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
